# ---------------------------------------------------------------------
# Embedding model (used at ingestion AND query time - keep it the same)
# ---------------------------------------------------------------------
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama

# ---------------------------------------------------------------------
# LLM used for annotation (docstring generation). This needs a
# completion/chat model, NOT the embedding model.
# ---------------------------------------------------------------------
ANNOTATE_MODEL=qwen3.8
ANNOTATE_BASE_URL=http://localhost:11434/v1
ANNOTATE_API_KEY=ollama

# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------
# Where Chroma data and the repo registry live.
CHROMA_DB_DIR=./db
#REGISTRY_FILE=./db/registry.json

# ---------------------------------------------------------------------
# Annotation behaviour
# ---------------------------------------------------------------------
# Git branch annotations are written to / created.
ANNOTATION_BRANCH=annotated

# ---------------------------------------------------------------------
# Chunking / size limits
# ---------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Files larger than this (bytes) are skipped at ingestion and reported.
MAX_FILE_BYTES=524288
# read_file_context truncates content at this many characters.
MAX_CONTEXT_CHARS=16000

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
# stdio (MCP client spawns this process) or streamable-http.
MCP_TRANSPORT=stdio
